{
 "openapi": "3.1.0",
 "info": {
  "title": "clerk serve",
  "version": "1.1.0",
  "description": "The clerk's local service (docs/service.md). One function per operation, no semantics in the server: each read runs the clerk command of the same name. This document is the single source of the contract (decision 46bb7a8c): routes and parameter checks derive from it, clients generate their types from it. Bound to loopback only (decision e745e9b2)."
 },
 "servers": [
  {
   "url": "http://127.0.0.1:5181"
  }
 ],
 "paths": {
  "/api/health": {
   "get": {
    "operationId": "health",
    "summary": "The service is up: its version, start time, programme and last sync.",
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "const": true
          },
          "payload": {
           "$ref": "#/components/schemas/Health"
          }
         },
         "required": [
          "ok",
          "payload"
         ],
         "additionalProperties": false
        }
       }
      }
     },
     "default": {
      "description": "refused or failed",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Failure"
        }
       }
      }
     }
    }
   }
  },
  "/api/sync": {
   "get": {
    "operationId": "syncStatus",
    "summary": "The last sync.",
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "const": true
          },
          "payload": {
           "$ref": "#/components/schemas/SyncStatus"
          }
         },
         "required": [
          "ok",
          "payload"
         ],
         "additionalProperties": false
        }
       }
      }
     },
     "default": {
      "description": "refused or failed",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Failure"
        }
       }
      }
     }
    }
   },
   "post": {
    "operationId": "syncNow",
    "summary": "Sync now: fast-forward srs-programme and the clerk when clean, then rewrite the programme and desk snapshots (both, whatever the desk's cadence). Needs the x-control-room header.",
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "const": true
          },
          "payload": {
           "$ref": "#/components/schemas/SyncStatus"
          }
         },
         "required": [
          "ok",
          "payload"
         ],
         "additionalProperties": false
        }
       }
      }
     },
     "default": {
      "description": "refused or failed",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Failure"
        }
       }
      }
     }
    },
    "x-clerk-act": true
   }
  },
