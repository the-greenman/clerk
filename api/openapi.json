  "/api/clerk/merge": {
   "post": {
    "operationId": "merge",
    "summary": "clerk merge <ref> --sha <sha> --json: the owner merges one PR at the head they reviewed. Refused (409, refused) unless the service runs as the owner (SRS_ACTOR), the repo is governed and the PR is open, clean and still at sha. Needs the x-control-room header.",
    "parameters": [
     {
      "name": "ref",
      "in": "query",
      "required": true,
      "description": "repo#n",
      "schema": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_.-]+#[0-9]+$"
      }
     },
     {
      "name": "sha",
      "in": "query",
      "required": true,
      "description": "the PR head the owner reviewed (40 hex)",
      "schema": {
       "type": "string",
       "pattern": "^[0-9a-f]{40}$"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "const": true
          },
          "payload": {
           "$ref": "#/components/schemas/Merged"
          }
         },
         "required": [
          "ok",
          "payload"
         ],
         "additionalProperties": false
        }
       }
      }
     },
     "default": {
      "description": "refused or failed",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Failure"
        }
       }
      }
     }
    },
    "x-clerk-act": true
   }
  }
 },
